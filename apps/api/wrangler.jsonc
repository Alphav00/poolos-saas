{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "poolos-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true,
	},
	// Only reachable at the custom domain, which sits behind Cloudflare Access.
	// workers.dev and preview URLs are off so nothing can bypass Access.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "poolos.pathofphi.com", "custom_domain": true }],
	// The built web app and the board pages. The Worker runs first on every
	// request so nothing is served before the Access token is checked.
	"assets": {
		"directory": "../web/dist",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"vars": {
		"ACCESS_TEAM_DOMAIN": "phi-agents.cloudflareaccess.com",
		// Audience tag of the PoolOS Access application.
		"ACCESS_AUD": "4db28440a6320c1dc9f22f201073ece46307c61d2e3c116e2980f88c1f8c034f",
		// Comma-separated. Owners can assign cards and approve requests on boards.
		"OWNER_EMAILS": "alphav00@gmail.com",
		// Where problem reports from the app open in Linear (src/feedback.ts):
		// team PoolOS, project "CCS Pools test drive", label "Tester report".
		// Nothing is sent until the LINEAR_API_KEY secret is set.
		"LINEAR_TEAM_ID": "d823f7a2-7856-4bf8-8569-3c2449010f3f",
		"LINEAR_PROJECT_ID": "beba12d4-a983-4da0-9663-df61a204ea7f",
		"LINEAR_LABEL_IDS": "25b17c55-169e-4cde-9fb4-1237d46eb8e9",
	},
	"d1_databases": [
		{ "binding": "DB", "database_name": "poolos", "database_id": "ff199d7f-f102-4fb0-97f1-0c7237b7a0e5", "migrations_dir": "migrations" },
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "poolos-files" }],
	// A second copy for trying a branch before it merges: its own Worker,
	// hostname and database (docs/DEPLOY.md, "Preview"). Deployed by
	// .github/workflows/preview.yml with `--env preview`. Vars and bindings
	// are not inherited from the top level, so they are repeated here.
	"env": {
		"preview": {
			"name": "poolos-preview",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [{ "pattern": "poolos-preview.pathofphi.com", "custom_domain": true }],
			"assets": {
				"directory": "../web/dist",
				"binding": "ASSETS",
				"run_worker_first": true,
			},
			"vars": {
				"ACCESS_TEAM_DOMAIN": "phi-agents.cloudflareaccess.com",
				// Same PoolOS Access application, with poolos-preview.pathofphi.com
				// added as a second domain, so the audience tag is the same.
				"ACCESS_AUD": "4db28440a6320c1dc9f22f201073ece46307c61d2e3c116e2980f88c1f8c034f",
				"OWNER_EMAILS": "alphav00@gmail.com",
				"LINEAR_TEAM_ID": "d823f7a2-7856-4bf8-8569-3c2449010f3f",
				"LINEAR_PROJECT_ID": "beba12d4-a983-4da0-9663-df61a204ea7f",
				"LINEAR_LABEL_IDS": "25b17c55-169e-4cde-9fb4-1237d46eb8e9",
			},
			"d1_databases": [
				{ "binding": "DB", "database_name": "poolos-preview", "database_id": "44bdada6-ea19-4fee-8bf8-e6a827c13e8e", "migrations_dir": "migrations" },
			],
			"r2_buckets": [{ "binding": "FILES", "bucket_name": "poolos-files" }],
		},
	},
}
